<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Voucher Viviana Peralta Estética</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Montserrat:wght@300;400;600&display=swap" rel="stylesheet">
<style>
:root{color-scheme:light;--bg:#debaaf;--card:#fffaf6;--tx:#3d2f2a;--mut:#6b564d;--ac:#4a5622;--bd:#c9a99d;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
html,body{margin:0;background:var(--bg)}
body{color:var(--tx);font-family:Montserrat,system-ui,-apple-system,Segoe UI,sans-serif}
main{max-width:520px;margin:0 auto;padding:22px 16px 40px}
h1{font-size:1.25rem;line-height:1.35;margin:0 0 20px;font-weight:600;text-align:center}
label{display:block;font-weight:600;margin:16px 0 6px;font-size:.95rem}
label small{font-weight:400;color:var(--mut)}
input{width:100%;box-sizing:border-box;font:inherit;font-size:1.05rem;padding:14px;border:1.5px solid var(--bd);border-radius:12px;background:var(--card);color:var(--tx)}
input:focus{outline:2px solid var(--ac);border-color:var(--ac)}
#out{width:100%;height:auto;border-radius:10px;margin-top:26px;display:block;box-shadow:0 4px 18px rgba(60,30,20,.18)}
button{width:100%;margin-top:18px;padding:17px;font:inherit;font-size:1.1rem;font-weight:600;border:0;border-radius:12px;background:var(--ac);color:#fff}
#msg{color:var(--tx);font-size:.9rem;text-align:center;margin-top:12px;min-height:1.2em}
</style>
</head>
<body>
<main>
<h1>Hola Vivi ♥<br>Rellená estos tres datos y el voucher se arma solo</h1>
<label for="p">Para (nombre de la clienta)</label>
<input id="p" placeholder="Ej: María López" autocomplete="off">
<label for="v">Vale por (tratamiento)</label>
<input id="v" placeholder="Ej: higiene facial" autocomplete="off">
<label for="d">Válido hasta (fecha)</label>
<input id="d" type="date">
<label for="o">De parte de <small>(opcional)</small></label>
<input id="o" placeholder="Si querés, quién regala" autocomplete="off">
<img id="out" alt="Vista previa del voucher">
<button id="sh">Guardar en mi teléfono</button>
<div id="msg"></div>
</main>
<script>
var TOP="data:image/jpeg;base64,";
var LOGO="data:image/png;base64,";
var $=function(i){return document.getElementById(i);};
var P=$("p"),V=$("v"),D=$("d"),O=$("o"),out=$("out"),msg=$("msg");
var topImg=new Image(),logoImg=new Image(),ready=0;
function ok(){ready++;if(ready===2)draw();}
topImg.onload=ok;logoImg.onload=ok;topImg.src=TOP;logoImg.src=LOGO;
var SANS="Montserrat,Helvetica,Arial,sans-serif",SCR="'Great Vibes','Brush Script MT',cursive";
function fitText(x,txt,max,size,font){while(size>22){x.font=size+"px "+font;if(x.measureText(txt).width<=max)return;size-=2;}}
function petals(x,cx,cy,col){x.fillStyle=col;[-62,-31,0,31,62].forEach(function(a){x.save();x.translate(cx,cy);x.rotate(a*Math.PI/180);x.beginPath();x.ellipse(70,0,70,19,0,0,Math.PI*2);x.fill();x.restore();});}
function line(x,x1,x2,y){x.strokeStyle="#cfcaa6";x.lineWidth=1.5;x.beginPath();x.moveTo(x1,y);x.lineTo(x2,y);x.stroke();}
function val(x,txt,xl,xr,y){if(!txt)return;x.fillStyle="#4a5622";x.textAlign="left";fitText(x,txt,xr-xl-16,52,SCR);x.fillText(txt,xl+10,y-10);}
function draw(){
if(ready<2)return;
var W=1084,Y0=748,H=Y0+872,c=document.createElement("canvas");c.width=W;c.height=H;var x=c.getContext("2d");
x.fillStyle="#eeedf3";x.fillRect(0,0,W,H);
x.drawImage(topImg,0,0,W,720);
x.fillStyle="#fbf8dc";x.fillRect(0,Y0,W,872);
x.save();x.beginPath();x.rect(0,Y0,W,872);x.clip();petals(x,-6,Y0+127,"#b5c08a");x.restore();
x.textBaseline="alphabetic";x.fillStyle="#3a3a2c";
x.textAlign="center";x.font="300 38px "+SANS;x.fillText("VALE POR UNA EXPERIENCIA INOLVIDABLE",542,Y0+135);
line(x,272,814,Y0+167);
x.textAlign="left";x.font="400 32px "+SANS;
x.fillText("VALE POR:",99,Y0+300);line(x,269,967,Y0+289);val(x,V.value,269,967,Y0+289);
x.fillStyle="#3a3a2c";x.font="400 32px "+SANS;
x.fillText("DE PARTE DE:",99,Y0+378);line(x,312,967,Y0+367);val(x,O.value,312,967,Y0+367);
x.fillStyle="#3a3a2c";x.font="400 32px "+SANS;
x.fillText("PARA:",99,Y0+461);line(x,195,967,Y0+450);val(x,P.value,195,967,Y0+450);
x.fillStyle="#3a3a2c";x.font="400 29px "+SANS;x.fillText("VÁLIDO HASTA:",279,Y0+557);
x.textAlign="center";x.font="300 36px "+SANS;x.fillText("/",625,Y0+558);x.fillText("/",772,Y0+558);
var dv=D.value?D.value.split("-"):null;
if(dv){x.fillStyle="#4a5622";x.font="40px "+SCR;x.fillText(dv[2],570,Y0+560);x.fillText(dv[1],698,Y0+560);x.fillText(dv[0],858,Y0+560);}
x.fillStyle="#6b6b55";x.font="300 29px "+SANS;x.textAlign="left";
x.fillText("@vivianaperalta.estetica",185,Y0+668);x.fillText("tel: 3534124374",665,Y0+668);
var lw=380,lh=lw*logoImg.height/logoImg.width;x.drawImage(logoImg,(W-lw)/2,Y0+722,lw,lh);
out.src=c.toDataURL("image/png");
}
[P,V,D,O].forEach(function(e){e.addEventListener("input",draw);});
if(document.fonts&&document.fonts.load){Promise.all([document.fonts.load("52px 'Great Vibes'"),document.fonts.load("300 38px Montserrat"),document.fonts.load("400 32px Montserrat")]).then(draw,function(){});}
function toBlob(){return fetch(out.src).then(function(r){return r.blob();});}
$("sh").onclick=function(){
msg.textContent="";
toBlob().then(function(b){
var f=new File([b],"voucher.png",{type:"image/png"});
function viaDownloads(){
 var a=document.createElement("a");a.href=URL.createObjectURL(b);a.download="voucher.png";document.body.appendChild(a);a.click();document.body.removeChild(a);
 setTimeout(function(){URL.revokeObjectURL(a.href);},4000);
 msg.textContent="¡Listo! El voucher se descargó en tu teléfono ♥ (buscalo en Descargas o Archivos)";
 return Promise.resolve();
}
function hint(){msg.textContent="Mantené apretada la imagen del voucher y elegí “Guardar imagen” ♥";}
if(navigator.canShare&&navigator.canShare({files:[f]})){
 return navigator.share({files:[f]}).then(function(){msg.textContent="Elegí “Guardar imagen” para que quede en tu galería ♥";}).catch(function(e){
  if(e&&e.name==="AbortError")return;
  return viaDownloads().catch(hint);
 });
}
return viaDownloads().catch(hint);
}).catch(function(){msg.textContent="No se pudo guardar. Mantené apretada la imagen y elegí “Guardar imagen”.";});
};
</script>
</body>
</html>
